{
  "name": "@mohitagw15856/rulebook",
  "version": "0.1.0",
  "description": "Settle the argument. Board and card game rules, the house rules everyone plays, and which of them are actually real.",
  "type": "module",
  "bin": {
    "rulebook": "bin/rulebook.mjs"
  },
  "exports": {
    ".": "./lib/registry.mjs",
    "./cards": "./lib/cards.mjs"
  },
  "files": [
    "bin/",
    "lib/",
    "games/",
    "LICENSE",
    "LICENSE-DATA"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:site": "node scripts/build-site.mjs",
    "validate": "node scripts/validate.mjs",
    "check": "node scripts/check-original.mjs",
    "test": "node scripts/test.mjs",
    "ci": "npm run validate && npm run check && npm test && npm run build && npm run build:site"
  },
  "keywords": [
    "board-games",
    "card-games",
    "rules",
    "house-rules",
    "uno",
    "poker",
    "catan",
    "scrabble",
    "monopoly",
    "rummy",
    "chess",
    "codenames",
    "game-night",
    "scoring",
    "cli",
    "offline"
  ],
  "author": "Mohit (mohitagw15856)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohitagw15856/rulebook.git"
  },
  "homepage": "https://github.com/mohitagw15856/rulebook#readme",
  "bugs": "https://github.com/mohitagw15856/rulebook/issues",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
