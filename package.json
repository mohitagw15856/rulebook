{
  "name": "@mohitagw15856/rulebook",
  "version": "0.5.0",
  "description": "Settle the argument. 37 board and card games including Xiangqi, 203 rulings, illustrations, free places to play, an MCP server and a JSON API.",
  "type": "module",
  "bin": {
    "rulebook": "bin/rulebook.mjs",
    "rulebook-mcp": "mcp/server.mjs"
  },
  "exports": {
    ".": "./lib/registry.mjs",
    "./cards": "./lib/cards.mjs",
    "./votes": "./lib/votes.mjs",
    "./mcp": "./mcp/server.mjs"
  },
  "files": [
    "bin/",
    "lib/",
    "games/",
    "mcp/",
    "bots/",
    "data/",
    ".rulebookrc.example",
    "LICENSE",
    "LICENSE-DATA"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:site": "node scripts/build-site.mjs",
    "validate": "node scripts/validate.mjs",
    "check": "node scripts/check-original.mjs",
    "coverage": "node scripts/coverage.mjs",
    "links": "node scripts/check-links.mjs",
    "mcp": "node mcp/server.mjs",
    "bot": "node bots/server.mjs",
    "test": "node scripts/test.mjs",
    "ci": "npm run validate && npm run check && npm test && npm run golden && npm run build && npm run build:site",
    "eval": "node scripts/eval.mjs",
    "archive": "node scripts/archive.mjs",
    "golden": "node scripts/golden.mjs",
    "daily": "node scripts/daily.mjs",
    "digest": "node scripts/digest.mjs"
  },
  "keywords": [
    "board-games",
    "card-games",
    "rules",
    "house-rules",
    "uno",
    "poker",
    "catan",
    "scrabble",
    "monopoly",
    "rummy",
    "chess",
    "codenames",
    "game-night",
    "scoring",
    "cli",
    "offline",
    "mcp",
    "mcp-server",
    "json-api",
    "discord-bot",
    "slack-bot",
    "tiebreak",
    "house-rules",
    "game-night",
    "llm-benchmark",
    "eval",
    "atom-feed",
    "embeddable-widget"
  ],
  "author": "Mohit (mohitagw15856)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohitagw15856/rulebook.git"
  },
  "homepage": "https://github.com/mohitagw15856/rulebook#readme",
