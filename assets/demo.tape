# vhs assets/demo.tape
Output assets/demo.gif

Set Shell zsh
Set FontSize 19
Set Width 1180
Set Height 880
Set Padding 22
Set Theme "Catppuccin Mocha"
Set TypingSpeed 28ms
Set PlaybackSpeed 0.85

Hide
Type 'clear; PS1="%F{green}$%f "; alias rulebook="node bin/rulebook.mjs"'
Enter
Type 'clear'
Enter
Show

Sleep 700ms
Type 'rulebook ruling uno "can I stack a draw 2"'
Sleep 500ms
Enter
Sleep 5s

Type 'clear'
Enter
Sleep 300ms

Type 'rulebook ruling monopoly "free parking"'
Sleep 400ms
Enter
Sleep 4500ms

Type 'clear'
Enter
Sleep 300ms

Type 'rulebook score poker "Ah Ad Kc Kh 2s" vs "Qs Qh Qd 7c 3d"'
Sleep 400ms
Enter
Sleep 3s

Type 'rulebook score gin "4c 5c 6c 7c 9h 9d 9s Kh Kd Ks"'
Sleep 400ms
Enter
Sleep 3500ms

Type 'clear'
Enter
Sleep 300ms

Type 'rulebook find --players 6 --minutes 30 --max-weight 2'
Sleep 400ms
Enter
Sleep 4s
